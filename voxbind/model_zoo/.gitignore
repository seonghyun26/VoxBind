# model_zoo/.gitignore -- keep this dir git-clean.
# Only lightweight tooling/docs are tracked in git:
#   .gitignore, *.sh (dropbox_push/pull), *.html (models.html), *.md (README.md)
# Everything else -- model weights, each model's cfg.yaml/.hydra/logs, bundles --
# is ignored here and travels via Dropbox instead (dropbox_push.sh / dropbox_pull.sh).

# model artifacts (weights + per-model config/logs) -> Dropbox, not git
*.pth
*.pth.tar
*.hydra
*.yaml
*.log
*.json

# transfer bundles (+ checksums); *.tar.sha256 is missed by the top-level *.tar rule
*.tar
*.tar.sha256

# generated_samples/ -- backed-up de-novo sample sets (SDF + prepared receptors).
# *.sdf/*.pdb are caught by the repo-root .gitignore; these receptor-prep artefacts
# are not, and a single sample set is ~100k files, so keep them out of git too.
*.pdbqt
*.pqr
